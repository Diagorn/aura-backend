	"item": [
		{
			"name": "Auth",
			"description": "Регистрация, вход, ротация refresh-токенов, выход, код связки с Telegram.",
			"item": [
				{
					"name": "Register",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"timezone\": \"Europe/Moscow\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": "{{baseUrl}}/api/v1/auth/register",
						"description": "Создаёт аккаунт и сразу возвращает пару токенов.\n201 — успех; 409 EMAIL_ALREADY_EXISTS; 422 — валидация.\ntimezone опциональна (по умолчанию Europe/Moscow, UTC+3).\n**Скрипт сохраняет accessToken/refreshToken в переменные коллекции.**"
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"if (pm.response.code === 201) {",
									"    const json = pm.response.json();",
									"    pm.collectionVariables.set('accessToken', json.accessToken);",
									"    pm.collectionVariables.set('refreshToken', json.refreshToken);",
									"    pm.test('токены сохранены', () => {",
									"        pm.expect(json.accessToken).to.be.a('string').and.not.be.empty;",
									"        pm.expect(json.refreshToken).to.be.a('string').and.not.be.empty;",
									"    });",
									"}"
								]
							}
						}
					],
